{
  "name": "evopt",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Budgeted prompt and tool-description optimization for existing agents",
  "engines": { "node": ">=22" },
  "bin": { "evopt": "dist/bin/evopt.js" },
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": { "types": "./dist/src/index.d.ts", "import": "./dist/src/index.js" },
    "./openai": { "types": "./dist/src/openai.d.ts", "import": "./dist/src/openai.js" },
    "./adapters": { "types": "./dist/src/adapters/index.d.ts", "import": "./dist/src/adapters/index.js" },
    "./adapters/openai": { "types": "./dist/src/adapters/openai.d.ts", "import": "./dist/src/adapters/openai.js" },
    "./adapters/anthropic": { "types": "./dist/src/adapters/anthropic.d.ts", "import": "./dist/src/adapters/anthropic.js" },
    "./adapters/claude": { "types": "./dist/src/adapters/anthropic.d.ts", "import": "./dist/src/adapters/anthropic.js" },
    "./adapters/cursor": { "types": "./dist/src/adapters/cursor.d.ts", "import": "./dist/src/adapters/cursor.js" },
    "./adapters/gemini": { "types": "./dist/src/adapters/gemini.d.ts", "import": "./dist/src/adapters/gemini.js" },
    "./benchmarks": { "types": "./dist/benchmarks/index.d.ts", "import": "./dist/benchmarks/index.js" }
  },
  "devDependencies": { "@types/node": "^22.0.0", "typescript": "^5.7.0" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "evopt": "node dist/bin/evopt.js",
    "test": "npm run build && node --test dist/test/*.test.js",
    "demo": "npm run build && node dist/bin/evopt.js run --config examples/offline.json"
  }
}
